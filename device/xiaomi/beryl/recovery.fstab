/system              erofs     super                                               flags=display="System";logical
/vendor              erofs     super                                               flags=display="Vendor";logical
/product             erofs     super                                               flags=display="Product";logical
/odm                 erofs     super                                               flags=display="ODM";logical

/boot                emmc      /dev/block/by-name/boot                             flags=display="Boot";backup=1;flashimg=1
/vendor_boot         emmc      /dev/block/by-name/vendor_boot                      flags=display="Vendor Boot";backup=1;flashimg=1
/recovery            emmc      /dev/block/by-name/recovery                         flags=display="Recovery";backup=1;flashimg=1

/data                f2fs      /dev/block/by-name/userdata                         flags=display="Data";encryptable=footer;length=-16384
/cache               ext4      /dev/block/by-name/cache                            flags=display="Cache";backup=1
/metadata            ext4      /dev/block/by-name/metadata                         flags=display="Metadata";backup=1
/persist             ext4      /dev/block/by-name/persist                          flags=display="Persist";backup=1;flashimg=1
